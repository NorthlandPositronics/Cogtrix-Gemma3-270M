# syntax=docker/dockerfile:1
# Gemma 3 270M – CPU-only, ultra-fast start, OpenAI-compatible (llama.cpp)

ARG GGUF_REPO=unsloth/gemma-3-270m-it-qat-GGUF
ARG GGUF_VARIANT=Q4_K_M
ARG LLAMA_ARG_CTX_SIZE=4096
ARG GGML_NATIVE=OFF

# ── Stage 1: build llama.cpp with OpenBLAS ───────────────────
FROM debian:12-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates wget libopenblas-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth=1 https://github.com/ggerganov/llama.cpp

WORKDIR /src/llama.cpp
ARG GGML_NATIVE
RUN cmake -S . -B build -DGGML_BLAS=ON -DGGML_BLAS_VENDOR=OpenBLAS -DGGML_NATIVE=${GGML_NATIVE} \
 && cmake --build build --target llama-server -j"$(nproc)"

# ── Stage 2: download GGUF (Q4_K_M) ──────────────────────────
FROM python:3.11-slim AS downloader
ARG GGUF_REPO
ARG GGUF_VARIANT
ENV GGUF_REPO=${GGUF_REPO}
ENV GGUF_VARIANT=${GGUF_VARIANT}
RUN pip install --no-cache-dir "huggingface-hub>=0.28.0"
COPY docker/download_gguf.py /tmp/download_gguf.py
RUN --mount=type=secret,id=hf_token python /tmp/download_gguf.py

# ── Stage 3: runtime ─────────────────────────────────────────
FROM debian:12-slim
ARG GGUF_REPO
ARG GGUF_VARIANT
ARG LLAMA_ARG_CTX_SIZE
ARG GGML_NATIVE

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas0 libgomp1 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --create-home --shell /bin/bash appuser

WORKDIR /app

COPY --from=build /src/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=build /src/llama.cpp/build/bin/*.so /usr/local/lib/
RUN for lib in libmtmd libllama libggml libggml-cpu libggml-base libggml-blas; do \
      if [ -f "/usr/local/lib/${lib}.so" ]; then ln -sf "/usr/local/lib/${lib}.so" "/usr/local/lib/${lib}.so.0"; fi; \
    done
ENV LD_LIBRARY_PATH=/usr/local/lib:/lib:/usr/lib
COPY --from=downloader /model /app/model

USER appuser

ENV OMP_NUM_THREADS=2
ENV GGUF_REPO=${GGUF_REPO}
ENV GGUF_VARIANT=${GGUF_VARIANT}
ENV GGML_NATIVE=${GGML_NATIVE}
ENV LLAMA_ARG_MODEL=/app/model/current-model.gguf
ENV LLAMA_ARG_CTX_SIZE=${LLAMA_ARG_CTX_SIZE}
ENV LLAMA_ARG_THREADS=2
ENV LLAMA_ARG_THREADS_BATCH=2
ENV LLAMA_ARG_BATCH=64
ENV LLAMA_ARG_UBATCH=64
ENV LLAMA_ARG_PARALLEL=1
ENV LLAMA_ARG_FLASH_ATTN=auto
ENV LLAMA_ARG_NO_WARMUP=1
ENV LLAMA_ARG_PORT=8080
ENV LLAMA_ARG_HOST=0.0.0.0

EXPOSE 8080

CMD ["sh", "-c", "set -eu; EXTRA=''; if [ \"${LLAMA_ARG_NO_WARMUP:-0}\" = \"1\" ]; then EXTRA='--no-warmup'; fi; exec llama-server --model ${LLAMA_ARG_MODEL} --ctx-size ${LLAMA_ARG_CTX_SIZE} --threads ${LLAMA_ARG_THREADS} --threads-batch ${LLAMA_ARG_THREADS_BATCH} --batch-size ${LLAMA_ARG_BATCH} --ubatch-size ${LLAMA_ARG_UBATCH} --parallel ${LLAMA_ARG_PARALLEL} --flash-attn ${LLAMA_ARG_FLASH_ATTN} ${EXTRA} --port ${LLAMA_ARG_PORT} --host ${LLAMA_ARG_HOST}"]
